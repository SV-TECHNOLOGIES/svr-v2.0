# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://svrtechgroups.com

# ── Contact form delivery ─────────────────────────────────────────────
# Where enquiries are sent.
CONTACT_TO_EMAIL=svrtechgroups@gmail.com

# Option A — Resend (https://resend.com). Set both to enable.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="SVR Tech Groups Website <onboarding@resend.dev>"

# Option B — Formspree (https://formspree.io). Paste your form endpoint.
FORMSPREE_ENDPOINT=
